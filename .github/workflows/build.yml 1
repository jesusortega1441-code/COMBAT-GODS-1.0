name: Compilar mod de Minecraft
on:
  push:
  workflow_dispatch:

permissions:
  contents: write

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: 17

      - uses: gradle/actions/setup-gradle@v3
        with:
          gradle-version: 8.8

      - name: Extraer src.zip y organizar estructura
        run: |
          echo "Descomprimiendo src.zip..."
          unzip -q src.zip -d extracted_src/
          
          # Crear la estructura estándar de forge si no existe
          mkdir -p src/main/resources
          mkdir -p src/main/java
          
          # Mover el contenido extraído al lugar correcto
          if [ -d "extracted_src/main" ]; then
            cp -r extracted_src/main/* src/main/
          elif [ -d "extracted_src/src/main" ]; then
            cp -r extracted_src/src/main/* src/main/
          else
            cp -r extracted_src/* src/main/
          fi
          
          echo "Verificando si el mods.toml ya está en su ruta:"
          find src -name "mods.toml"

      - name: Compilar mod con Gradle
        run: gradle build --no-daemon --stacktrace

      - name: Verificar el archivo .jar y el mods.toml
        run: |
          ls -la build/libs
          unzip -l build/libs/*.jar | grep -q "META-INF/mods.toml" || { echo "ERROR: FALTA el mods.toml dentro del jar"; exit 1; }
          echo "¡Éxito total! El mods.toml está dentro del jar."

      - name: Subir el .jar listo a Releases
        uses: softprops/action-gh-release@v2
        with:
          tag_name: version-final
          name: Combat Gods Mod (.jar)
          prerelease: true
          files: build/libs/*.jar
